# Copy these into Vercel → Project → Settings → Environment Variables.
# Never commit real values to GitHub.

# Turns on real Mercado Pago checkout in the app (leave "false" for the demo)
VITE_MP_ENABLED=false

# Mercado Pago access token (server only). Use a TEST token first:
# Mercado Pago → Tus integraciones → Credenciales de prueba
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000

# Your public site address, used for the return page after paying
SITE_URL=https://super-m.vercel.app
